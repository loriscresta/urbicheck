{
  "name": "WFS Analisi Geospaziale su Nuova Query",
  "description": "Trigger automatico server-side: esegue wfsLiguria (WFS PAI ARPA, Overpass API) quando viene creata una nuova CadastralQuery per Liguria o Piemonte. Evita CORS dal browser.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CadastralQuery"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "wfs_analisi_geospaziale_su_nuova_query",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "triggerWfsOnNewQuery",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "triggerWfsOnNewQuery"
  }
}